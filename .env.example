# La Escuela VT: la portada actual no necesita claves ni variables de aplicación.
# Archivo NUEVO de documentación; no existía un .env versionado en el origen.
# No añadas credenciales a Git. Las opciones siguientes son de herramientas.

# Evita consultas auxiliares de Miniflare y telemetría (valores por defecto del código):
# CLOUDFLARE_CF_FETCH_ENABLED=false
# WRANGLER_SEND_METRICS=false
# WRANGLER_WRITE_LOGS=false

# Opciones locales; normalmente no necesitas establecerlas:
# SITES_RUNTIME_ROOT=.sites-runtime
# WRANGLER_LOG_PATH=.wrangler/logs
# WRANGLER_REGISTRY_PATH=.wrangler/dev-registry
# MINIFLARE_REGISTRY_PATH=.wrangler/registry
# SITES_BUILD_TIMEOUT=3m
# SITES_BUILD_KILL_AFTER=10s

# DB, BUCKET y CONNECTORS son bindings de Workers, no contraseñas .env.
# En el manifiesto actual D1 y R2 están desactivados (null).
# El inicio de sesión y el control de acceso privado de Sites se configuran
# en esa plataforma; no se han exportado sus cookies, secretos ni usuarios.
